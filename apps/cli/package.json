{
  "name": "agent-valley",
  "version": "2.3.1",
  "type": "module",
  "engines": {
    "node": ">=26.10.0",
    "bun": ">=1.4.2"
  },
  "description": "AI agent orchestrator — dispatch Linear issues to Claude, Codex, and Gemini agents in isolated git worktrees",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/first-fluke/agent-valley.git",
    "directory": "apps/cli"
  },
  "keywords": [
    "ai",
    "agent",
    "orchestrator",
    "linear",
    "claude",
    "codex",
    "gemini",
    "cli"
  ],
  "bin": {
    "av": "dist/index.js",
    "agent-valley": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "av": "bun run src/index.ts",
    "build": "bun run build.ts",
    "prepublishOnly": "node -e \"console.error('Publish the staged package from dist/npm after building and running the standalone package smoke check.'); process.exit(1)\""
  },
  "dependencies": {
    "@agent-valley/core": "workspace:*",
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "jose": "^6.2.12",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.9.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.0"
  }
}
